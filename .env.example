# فایل را به .env تغییر نام دهید و مقادیر محلی را تنظیم کنید.
SECRET_KEY=replace-this-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=Europe/Berlin

DB_NAME=marketanalysis_db
DB_USER=marketanalysis_app
DB_PASSWORD=replace-this-with-the-password-created-by-setup
DB_HOST=127.0.0.1
DB_PORT=5432

# کلید API را فقط در فایل .env محلی قرار دهید؛ آن را در چت یا Git ارسال نکنید.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
AI_MAX_CANDLES=35
AI_REQUIRE_ADMIN_APPROVAL=True
MAX_CSV_SIZE_MB=20
MAX_CANDLES_PER_REQUEST=5000
ARTICLE_REQUIRE_ADMIN_APPROVAL=False
